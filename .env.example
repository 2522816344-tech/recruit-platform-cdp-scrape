# ============================================
# recruit-platform-cdp-scrape — 环境变量模板
# 复制本文件为 .env（已在 .gitignore 内），按需取消注释并填值
# 所有变量均可省略——省略即用内置默认值
# ============================================

# 工作目录：放 companies.json 的地方
# 默认为进程当前目录
SCRAPE_DIR=

# 数据目录：放 <platform>_all.jsonl / .progress_<platform> / 截图 等
# 默认为 <SCRAPE_DIR>/data
SCRAPE_DATA=

# 配置文件路径
# 默认为 <SCRAPE_DIR>/config.json
SCRAPE_CONFIG=

# 公司名单路径
# 默认为 <SCRAPE_DIR>/companies.json
SCRAPE_COMPANIES=

# Chrome DevTools Protocol 调试端口
# 默认 9222
CDP_PORT=9222

# 浏览器可执行文件路径（自动探测失败时手动指定）
# 自动检测顺序：Chrome → Edge → Chromium
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux: /usr/bin/google-chrome
# Windows: %ProgramFiles%\Google\Chrome\Application\chrome.exe
BROWSER_EXE=

# 抓取专用 profile 目录
# 默认为 <SCRAPE_DIR>/chrome-profile/User Data
# ⚠️ 该目录含登录态 Cookie，请勿提交到任何远程仓库
CHROME_PROFILE=

# 需要走代理时填，如 http://127.0.0.1:7890
# 不填则直连
CHROME_PROXY=

# 账号用户名（用于登录态判定；不强制需要）
# 在已登录浏览器中可保持空
SCRAPE_USER=

# 本地城市正则（覆盖 config 里的 localCityRe）
# 例如：北京|海淀|朝阳
LOCAL_CITY_RE=

# Python 解释器（默认 python3，Windows 默认 py）
PYTHON=